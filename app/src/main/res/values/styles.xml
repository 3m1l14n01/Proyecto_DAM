<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.SPORTSGD.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sportsgd_text_primary</item>
    </style>

    <style name="TextAppearance.SPORTSGD.CardTitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sportsgd_text_primary</item>
    </style>

    <style name="TextAppearance.SPORTSGD.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sportsgd_text_primary</item>
    </style>

    <style name="TextAppearance.SPORTSGD.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/sportsgd_text_primary</item>
    </style>

    <style name="TextAppearance.SPORTSGD.Body.Secondary" parent="TextAppearance.SPORTSGD.Body">
        <item name="android:textColor">@color/sportsgd_text_secondary</item>
    </style>

    <style name="TextAppearance.SPORTSGD.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/sportsgd_text_primary</item>
    </style>

    <style name="TextAppearance.SPORTSGD.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/sportsgd_text_secondary</item>
    </style>

    <style name="TextAppearance.SPORTSGD.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sportsgd_primary</item>
    </style>

    <style name="Widget.SPORTSGD.Card.Surface" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/sportsgd_surface</item>
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.SPORTSGD.Card.White" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/sportsgd_white</item>
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/sportsgd_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.SPORTSGD.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sportsgd_white</item>
        <item name="backgroundTint">@color/sportsgd_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.SPORTSGD.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sportsgd_primary</item>
        <item name="backgroundTint">@color/sportsgd_white</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/sportsgd_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.SPORTSGD.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/sportsgd_white</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintTextColor">@color/sportsgd_text_secondary</item>
    </style>

    <style name="Widget.SPORTSGD.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/sportsgd_text_primary</item>
        <item name="android:textColorHint">@color/sportsgd_text_secondary</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>
