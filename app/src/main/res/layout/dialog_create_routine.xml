<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoutinePlayer"
            style="@style/Widget.SPORTSGD.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/goal_player_label"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/actvRoutinePlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/goal_player_label"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoutineGoal"
            style="@style/Widget.SPORTSGD.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/routine_form_goal"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/actvRoutineGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/routine_form_goal"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoutineTitle"
            style="@style/Widget.SPORTSGD.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/routine_form_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoutineTitle"
                style="@style/Widget.SPORTSGD.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoutineDescription"
            style="@style/Widget.SPORTSGD.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/routine_form_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoutineDescription"
                style="@style/Widget.SPORTSGD.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoutineDuration"
            style="@style/Widget.SPORTSGD.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/routine_form_duration">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoutineDuration"
                style="@style/Widget.SPORTSGD.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoutineSteps"
            style="@style/Widget.SPORTSGD.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/routine_form_steps"
            app:helperText="@string/routine_form_steps_hint"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoutineSteps"
                style="@style/Widget.SPORTSGD.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="120dp"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
