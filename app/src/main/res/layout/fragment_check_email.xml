<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sportsgd_canvas"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="844dp"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <ImageView
            android:id="@+id/ivCheckEmailLogo"
            android:layout_width="@dimen/logo_large"
            android:layout_height="@dimen/logo_large"
            android:contentDescription="@string/content_description_logo"
            android:src="@drawable/sportsgd_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="64dp" />

        <ImageView
            android:id="@+id/ivEmailStatus"
            android:layout_width="@dimen/status_icon"
            android:layout_height="@dimen/status_icon"
            android:contentDescription="@string/check_email_title"
            android:src="@drawable/sportsgd_email"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="222dp" />

        <TextView
            android:id="@+id/tvCheckEmailTitle"
            style="@style/TextAppearance.SPORTSGD.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_email_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="340dp" />

        <TextView
            android:id="@+id/tvCheckEmailDescription"
            style="@style/TextAppearance.SPORTSGD.Body.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:text="@string/check_email_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="388dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturnToLogin"
            style="@style/Widget.SPORTSGD.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:text="@string/return_to_login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="510dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>



