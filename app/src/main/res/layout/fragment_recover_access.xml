<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sportsgd_canvas"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="844dp"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <ImageView
            android:id="@+id/ivRecoveryLogo"
            android:layout_width="@dimen/logo_large"
            android:layout_height="@dimen/logo_large"
            android:contentDescription="@string/content_description_logo"
            android:src="@drawable/sportsgd_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="64dp" />

        <TextView
            android:id="@+id/tvRecoverTitle"
            style="@style/TextAppearance.SPORTSGD.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/recover_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="166dp" />

        <TextView
            android:id="@+id/tvRecoverDescription"
            style="@style/TextAppearance.SPORTSGD.Body.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recover_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRecoverTitle" />

        <TextView
            android:id="@+id/tvRecoveryEmailLabel"
            style="@style/TextAppearance.SPORTSGD.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/email_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="300dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRecoveryEmail"
            style="@style/Widget.SPORTSGD.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRecoveryEmailLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRecoveryEmail"
                style="@style/Widget.SPORTSGD.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:hint="@string/email_hint"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueRecovery"
            style="@style/Widget.SPORTSGD.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="28dp"
            android:text="@string/continue_action"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilRecoveryEmail" />

        <TextView
            android:id="@+id/tvRecoveryNotice"
            style="@style/TextAppearance.SPORTSGD.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/recover_demo_notice"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnContinueRecovery" />

        <TextView
            android:id="@+id/btnBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="@string/back_to_login"
            android:textColor="@color/sportsgd_primary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="520dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>



