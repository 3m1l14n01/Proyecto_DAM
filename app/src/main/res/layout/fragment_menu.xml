<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sportsgd_canvas"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="844dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height"
            android:background="@color/sportsgd_primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btnCloseMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/content_description_close_menu"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/close_symbol"
                android:textColor="@color/sportsgd_white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="26dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TextAppearance.SPORTSGD.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu" />

            <TextView
                style="@style/TextAppearance.SPORTSGD.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/menu_description" />

            <LinearLayout
                android:id="@+id/btnMenuHome"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="27dp"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/TextAppearance.SPORTSGD.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chevron"
                    android:textColor="@color/sportsgd_primary"
                    android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuPlayers"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView style="@style/TextAppearance.SPORTSGD.CardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/players" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chevron" android:textColor="@color/sportsgd_primary" android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuCalendar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView style="@style/TextAppearance.SPORTSGD.CardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/calendar" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chevron" android:textColor="@color/sportsgd_primary" android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuGoals"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView style="@style/TextAppearance.SPORTSGD.CardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/goals_and_routines" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chevron" android:textColor="@color/sportsgd_primary" android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuNotifications"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView style="@style/TextAppearance.SPORTSGD.CardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/notifications" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chevron" android:textColor="@color/sportsgd_primary" android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/open_profile"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMenuUserName"
                    style="@style/TextAppearance.SPORTSGD.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_name" />

                <TextView
                    android:id="@+id/tvMenuSession"
                    style="@style/TextAppearance.SPORTSGD.Body.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/demo_session" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenuLogout"
                style="@style/Widget.SPORTSGD.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="48dp"
                android:text="@string/logout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>


